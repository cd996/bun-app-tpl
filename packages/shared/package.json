{
  "name": "@app/shared",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "description": "ECIES utilities shared between api and web.",
  "homepage": "https://github.com/zzci",
  "repository": {
    "type": "git",
    "url": "https://github.com/zzci/bun-app-tpl.git",
    "directory": "packages/shared"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest --run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@noble/secp256k1": "^3.0.0"
  },
  "devDependencies": {
    "@app/tsconfig": "workspace:*",
    "tsdown": "^0.22.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
