{
  "name": "@app/api",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "description": "Hono + OpenAPI API on Bun with Drizzle SQLite storage and optional ECIES at-rest encryption.",
  "homepage": "https://github.com/zzci",
  "repository": {
    "type": "git",
    "url": "https://github.com/zzci/bun-app-tpl.git",
    "directory": "apps/api"
  },
  "exports": {
    ".": "./src/dev.ts"
  },
  "scripts": {
    "dev": "nsl run --name \"${APP_NAME:-app}:${BASE_PATH:-}/api\" bun --env-file=../../.env --watch src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun --minify",
    "start": "bun dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@app/shared": "workspace:*",
    "@hono/zod-openapi": "^1.4.0",
    "@libsql/client": "^0.17.3",
    "consola": "^3.4.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.18",
    "nanoid": "^5.1.11",
    "oauth4webapi": "^3.8.6",
    "otpauth": "^9.5.1",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "request-ip": "^3.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@app/tsconfig": "workspace:*",
    "@types/bun": "^1.3.13",
    "@types/qrcode": "^1.5.6",
    "@types/request-ip": "^0.0.41",
    "drizzle-kit": "^0.31.10",
    "typescript": "catalog:"
  }
}
