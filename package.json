{
  "name": "app",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "description": "Bun monorepo template for OAuth-backed internal workspaces.",
  "homepage": "https://github.com/zzci",
  "repository": {
    "type": "git",
    "url": "https://github.com/zzci/bun-app-tpl.git"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "catalog": {
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "scripts": {
    "dev": "bun run --filter '@app/*' dev",
    "dev:dex": "bun scripts/dev-dex.ts",
    "build": "bun run --filter '*' build",
    "lint": "eslint apps/ packages/ --ext .ts,.tsx",
    "lint:fix": "eslint apps/ packages/ --ext .ts,.tsx --fix",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test",
    "test:e2e": "bun tests/e2e/run.ts",
    "check": "bun run lint && bun run typecheck && bun run test && bun run build && bun run check:i18n",
    "check:i18n": "bun scripts/check-i18n.ts",
    "compile": "bun scripts/compile.ts",
    "clean": "bun scripts/clean.ts",
    "clean:all": "bun scripts/clean.ts --all"
  },
  "dependencies": {
    "otpauth": "^9.5.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^8",
    "@app/tsconfig": "workspace:*",
    "@eslint-react/eslint-plugin": "^3",
    "@nsio/nsl": "^0.1.5",
    "@types/qrcode": "^1.5.6",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "typescript": "catalog:"
  }
}
